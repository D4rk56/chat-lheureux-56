rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidCat(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100
        && (data.status in ['Disponible', 'Urgence', 'Réservé', 'Adopté'])
        && (data.gender in ['Femelle', 'Mâle'] || data.sex in ['Femelle', 'Mâle'])
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 10));
    }
    
    function isValidTestimonial(data) {
      return data.catName is string && data.catName.size() > 0
        && data.content is string && data.content.size() > 0
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 10));
    }

    // Collection des chats
    match /chats/{catId} {
      // Lecture publique autorisée pour le site vitrine et l'edge function
      allow read: if true;
      
      // Seuls les utilisateurs connectés peuvent créer, modifier ou supprimer
      allow create: if isAuthenticated() && isValidCat(request.resource.data);
      allow update: if isAuthenticated() && (
        isValidCat(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editingLock'])
      );
      allow delete: if isAuthenticated();
    }

    // Collection des avis et témoignages
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidTestimonial(request.resource.data);
      allow update: if isAuthenticated() && isValidTestimonial(request.resource.data);
      allow delete: if isAuthenticated();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'dark56100@gmail.com' ||
        request.auth.token.email == 'asso.chatslheureux@gmail.com'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrateur')
      );
    }

    // Collection des profils membres et rôles
    match /users/{userId} {
      // Les membres connectés peuvent consulter la liste des membres
      allow read: if isAuthenticated();
      // Création : les admins peuvent créer (y compris comptes manuels), et les utilisateurs peuvent créer leur propre profil initial (sans s'auto-promouvoir Administrateur sauf super-admin)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (request.resource.data.role != 'Administrateur' || isSuperAdmin()))
      );
      // Modification : les admins peuvent tout modifier (y compris le rôle), les utilisateurs ne peuvent modifier que leur propre profil sans altérer leur rôle ou statut admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin', 'isPresident']))
      );
      // Suppression : strictement réservée aux administrateurs
      allow delete: if isAdmin();
    }

    // Collection des codes d'invitation bénévoles
    match /invitationCodes/{codeId} {
      // Lecture unitaire par ID direct autorisée pour valider le code lors de l'inscription
      // (Empêche l'énumération / fuite publique de tous les codes générés)
      allow get: if true;
      // Listing de l'ensemble des codes strictement réservé aux membres connectés
      allow list: if isAuthenticated();
      // Création et suppression strictement réservées aux administrateurs
      allow create, delete: if isAdmin();
      // Consommation d'un code autorisée lors de l'inscription (marquage unique used = true)
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedByEmail', 'usedAt'])
        && request.resource.data.used == true
        && resource.data.used == false
      );
    }

    // Collection des demandes d'adoption (questionnaire officiel)
    match /adoptionRequests/{requestId} {
      // Soumission publique autorisée avec validation minimale
      allow create: if request.resource.data.catName is string
        && request.resource.data.fullName is string
        && request.resource.data.email is string;
      // Lecture, suivi et suppression réservés aux membres connectés
      allow read, update, delete: if isAuthenticated();
    }
    
    // Par défaut, refuser tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
